# Copia in .env e compila. Il file .env non va condiviso.
PORT=3000
# Chiave Google Places (API "New"), usata solo dal server per TrovaCibo. Senza chiave la ricerca dal vivo resta spenta.
GOOGLE_PLACES_API_KEY=
# Numero massimo di ricerche Places al giorno (tetto di spesa)
PLACES_DAILY_BUDGET=150
# Durata della sessione amministratore, in minuti
ADMIN_SESSION_MINUTES=120
# Metti 1 se il server sta dietro un proxy (Render, Fly, nginx...) per leggere l'IP reale nei limiti ai tentativi
TRUST_PROXY=0
# Cartella dei dati modificabili (su un hosting usa un volume persistente)
# DATA_DIR=/data
# Archivio Supabase (tabella creata con supabase/schema.sql). Ha la precedenza su Redis e sui file in data/.
# La chiave di servizio va tenuta segreta: solo qui e nelle variabili d'ambiente del server.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# In alternativa: Redis via REST (Upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PIN unico degli organizzatori (almeno 6 caratteri). Mai nel repository: solo qui e nelle variabili d'ambiente del server.
# ADMIN_PIN=
# Nome mostrato nel pannello Admin per chi entra con il PIN
# ADMIN_NAME=Organizzatori
# In alternativa a un database: salvare su GitHub (ogni modifica è un commit di data/seed.json).
# Token "fine-grained" limitato a questo repository, permesso Contents: Read and write.
# GITHUB_TOKEN=
# GITHUB_REPO=proprietario/repository
# GITHUB_BRANCH=main
# Facoltativo: chiave per firmare le sessioni admin (altrimenti ne viene generata una e salvata nell'archivio)
# SESSION_SECRET=
